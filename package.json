{
  "name": "opencontrib-monorepo",
  "version": "1.0.0",
  "description": "Agent-Native Open Source Contribution Engine — CLI interface and domain core",
  "author": "OpenContrib Contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeiSiristhebest/opencontrib.git"
  },
  "bugs": {
    "url": "https://github.com/MeiSiristhebest/opencontrib/issues"
  },
  "homepage": "https://github.com/MeiSiristhebest/opencontrib#readme",
  "keywords": [
    "open-source",
    "cli",
    "agentic-ai",
    "autonomous-agent",
    "developer-tools",
    "github-contributions",
    "governance",
    "opencontrib"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test --timeout 30000",
    "test:integration": "OPENCONTRIB_NETWORK_TESTS=1 bun test --timeout 60000",
    "coverage:domain": "bun run --filter @opencontrib/core coverage:gate",
    "build": "bun run --filter '*' build",
    "mcp": "bun run packages/mcp-server/src/index.ts",
    "cli": "bun run packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
